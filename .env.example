# SIDRA AI configuration template.
# v0.1 does NOT auto-load `.env`; export/set these values in the process
# environment (or a separately reviewed local service manager). If you copy
# this file locally for reference, the `.env` name is gitignored but is not
# loaded by SIDRA AI itself. NEVER commit a filled-in copy.
# Every value below is a placeholder, not a credential.

# --- API exposure -----------------------------------------------------
# Loopback by default. Do not change without reviewing docs/SECURITY.md.
SIDRA_HOST=127.0.0.1
SIDRA_PORT=8787

# Whenever SIDRA_API_TOKEN is set, use visible ASCII characters only. Binding
# beyond loopback additionally requires BOTH of these. For non-loopback binds,
# SIDRA_API_TOKEN must contain at least 24 visible ASCII characters; this is
# only a minimum accidental-weakness guard, so generate a random token with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# SIDRA_ALLOW_PUBLIC_BIND=false
# SIDRA_API_TOKEN=

SIDRA_RATE_LIMIT_PER_MINUTE=60

# --- Model backend (verified v0.1 local-only set) ----------------------
# echo | ollama | llama_cpp
# `transformers` is intentionally deferred until it can load only pre-staged
# local artifacts with no runtime Hub/code/weight download path.
#
# `echo` needs no GPU or model manifest. For `ollama` and `llama_cpp`, normal
# SidraService startup requires `<SIDRA_DATA_DIR>/model-manifest.json` to contain
# exactly one reviewed entry matching SIDRA_MODEL_BACKEND + SIDRA_MODEL_NAME.
# A fresh bounded NVIDIA free-VRAM probe must also admit that exact model and
# its reviewed maximum context before the API socket is opened. Probe/manifest/
# routing failure is fail-closed; there is no static 6 GiB fallback.
SIDRA_MODEL_BACKEND=echo
SIDRA_MODEL_NAME=sidra-local-v0
# SIDRA_MODEL_ENDPOINT=http://127.0.0.1:11434
SIDRA_MODEL_MAX_OUTPUT_TOKENS=512

# --- GitHub (read-only) ------------------------------------------------
# Optional. A fine-grained token with *read* scope only raises rate limits
# and allows private repositories. v0.1 has no code path that writes.
# SIDRA_GITHUB_TOKEN=
# Authenticated GitHub reads are pinned to the official API origin. Any other
# scheme/host/path/query is rejected before the optional token can be used.
# SIDRA_GITHUB_API_BASE=https://api.github.com
# If SIDRA_ALLOWED_REPOSITORIES is unset, the reviewed built-in list is used.
# If it is explicitly set to an empty/whitespace value, the allowed repository
# set is empty; SIDRA does not broaden that operator choice back to defaults.
SIDRA_ALLOWED_REPOSITORIES=tukemen-rgb/site,tukemen-rgb/creater-yard,tukemen-rgb/Fg,tukemen-rgb/marketing,tukemen-rgb/sidra-ai
SIDRA_MAX_ITEMS_PER_SOURCE=50

# --- Fetch Plane (post-v0.1 integration candidate) ---------------------
# There are intentionally NO SIDRA_FETCH_* environment settings yet.
# The isolated FetchBroker library is not wired into sidra-api and its
# constructor-injected FetchPolicy defaults to an empty allowed-host set.
# Adding an environment-driven Web allowlist or API route requires separate
# review plus the exact-SHA integration gate; do not invent local variables here.

# --- Security gate -----------------------------------------------------
SIDRA_MAX_INPUT_BYTES=524288
SIDRA_QUARANTINE_PROMPT_INJECTION=true

# --- Storage -----------------------------------------------------------
# Non-echo startup reads the reviewed manifest from
# `<SIDRA_DATA_DIR>/model-manifest.json`. Keep this local state out of Git.
SIDRA_DATA_DIR=.sidra
